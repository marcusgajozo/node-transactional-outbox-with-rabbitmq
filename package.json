{
  "name": "node-transactional-outbox-with-rabbitmq",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env ./src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env ./src/database/migrate.ts latest",
    "db:rollback": "node --env-file-if-exists=.env ./src/database/migrate.ts rollback",
    "db:make": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile ./src/database/knexfile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "dependencies": {
    "fastify": "^5.12.7",
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
